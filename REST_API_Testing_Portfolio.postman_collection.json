              "});",
              "",
              "pm.test(\"Response title matches request\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.title).to.eql(\"Test Post Title\");",
              "});",
              "",
              "pm.test(\"Response body matches request\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.body).to.eql(\"This is the body of the test post.\");",
              "});",
              "",
              "pm.test(\"Response userId matches request\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.userId).to.eql(1);",
              "});",
              "",
              "pm.test(\"Response time is less than 2000ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});"
            ]
          }
        }
      ],
